ASP_ENVIRONMENT=local
ASP_LOG_LEVEL=INFO
ASP_ENABLE_DATABASE=true
ASP_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/austin_surface_pros
ASP_ENABLE_SES=false
ASP_SES_REGION=us-east-1
ASP_SES_SOURCE_EMAIL=no-reply@austinsurfacepros.com
ASP_SES_RECIPIENT_EMAILS=["austinsurfacepros@gmail.com"]
ASP_CORS_ORIGINS=["http://localhost:4200"]
ASP_JWT_SECRET_KEY=insecure-local-development-secret
ASP_JWT_ALGORITHM=HS256
ASP_JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
ASP_BLOG_UPLOADS_DIR=uploads/blog
ASP_ENABLE_GALLERY_STORAGE=false
ASP_GALLERY_BUCKET_NAME=
ASP_GALLERY_REGION=us-east-1
ASP_GALLERY_PUBLIC_BASE_URL=
ASP_GALLERY_UPLOAD_EXPIRES_SECONDS=300
